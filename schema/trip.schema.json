{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tumu987/tumu-roadbook/schema/trip.schema.json",
  "title": "Tumu Roadbook Trip",
  "type": "object",
  "additionalProperties": false,
  "required": ["trip", "days"],
  "properties": {
    "trip": {"$ref": "#/$defs/trip"},
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/day"}
    },
    "cities": {
      "oneOf": [
        {"type": "object", "additionalProperties": {"$ref": "#/$defs/coordinate"}},
        {"type": "array", "items": {"type": "string", "minLength": 1}}
      ]
    },
    "pois": {
      "type": "array",
      "items": {"$ref": "#/$defs/poi"}
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {"type": "number", "minimum": -90, "maximum": 90},
        {"type": "number", "minimum": -180, "maximum": 180}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "coordinateRef": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"$ref": "#/$defs/coordinate"}
      ]
    },
    "focus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "center", "zoom"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "center": {"$ref": "#/$defs/coordinate"},
        "zoom": {"type": "integer", "minimum": 1, "maximum": 20}
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "days": {"type": "integer", "minimum": 1},
        "distance": {"type": ["string", "number"]},
        "heritage": {"type": ["string", "number"]},
        "people": {"type": "integer", "minimum": 1}
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {"type": "integer", "minimum": 1},
        "region": {"type": "string", "minLength": 1},
        "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "drivers"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "dates": {"type": "string"},
        "start_date": {"type": "string", "format": "date"},
        "basemap": {"enum": ["light", "dark", "terrain"]},
        "drivers": {"type": "integer", "minimum": 1, "maximum": 3},
        "coordinate_verification": {"enum": ["advisory", "strict"]},
        "timeline_mode": {"enum": ["split", "merged"]},
        "focus": {"$ref": "#/$defs/focus"},
        "stats": {"$ref": "#/$defs/stats"},
        "index": {"$ref": "#/$defs/index"},
        "colors": {
          "type": "object",
          "propertyNames": {"pattern": "^D[0-9]+$"},
          "additionalProperties": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}
        }
      }
    },
    "poi": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rank"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "rank": {"enum": ["major", "minor"]},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "lng": {"type": "number", "minimum": -180, "maximum": 180},
        "coord": {"$ref": "#/$defs/coordinate"},
        "hint": {"type": "string"},
        "iconAnchor": {
          "type": "array",
          "prefixItems": [{"type": "number"}, {"type": "number"}],
          "minItems": 2,
          "maxItems": 2
        },
        "shuttle": {"type": "boolean"},
        "coord_source": {"enum": ["osm", "official", "field_check", "manual"]},
        "osm_id": {"type": "string", "pattern": "^(node|way|relation)/[0-9]+$"},
        "verified_at": {"type": "string", "format": "date"}
      }
    },
    "routeSegment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label"],
      "properties": {"label": {"type": "string", "minLength": 1}}
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"$ref": "#/$defs/coordinateRef"},
        "end": {"$ref": "#/$defs/coordinateRef"},
        "via": {"type": "array", "items": {"$ref": "#/$defs/coordinateRef"}},
        "terrain": {"enum": ["highway", "national", "mountain"]},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/routeSegment"}}
      }
    },
    "timelineNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "time": {"type": "string", "minLength": 1},
        "duration": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "kind": {"enum": ["fixed", "anchor", "drive", "visit", "meal", "rest"]}
      },
      "oneOf": [
        {"required": ["time"]},
        {"required": ["duration"]}
      ]
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["day", "label", "theme", "route"],
      "properties": {
        "day": {"type": "integer", "minimum": 1},
        "label": {"type": "string", "minLength": 1},
        "theme": {"type": "string", "minLength": 1},
        "city": {"type": "string"},
        "day_type": {"enum": ["transit", "local"]},
        "route_class": {"enum": ["main", "spur", "branch", "minor"]},
        "distance": {"type": "string"},
        "route": {"$ref": "#/$defs/route"},
        "items": {"type": "array", "items": {"type": "string"}},
        "stop_tags": {"type": "array", "items": {"type": "string"}},
        "tips": {"type": "array", "items": {"type": "string"}},
        "pois": {"type": "array", "items": {"$ref": "#/$defs/poi"}},
        "timeline": {"type": "array", "items": {"$ref": "#/$defs/timelineNode"}}
      }
    }
  }
}
